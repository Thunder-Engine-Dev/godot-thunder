+
+#define MULT16_32_Q15(a,b)     ((a)*(b))
+#define MULT16_32_Q16(a,b)     ((a)*(b))
+
+#define MULT32_32_Q16(a,b)     ((a)*(b))
+#define MULT32_32_Q31(a,b)     ((a)*(b))
