index 0000000000000000000000000000000000000000..4342614dcccc11348bf9e45c4e20691e19f69982
--- /dev/null
+++ b/thirdparty/libopus/silk/resampler_down2_3.c
@@ -0,0 +1,103 @@
+/***********************************************************************
