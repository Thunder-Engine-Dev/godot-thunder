index 0000000000000000000000000000000000000000..4b7e19ea596782e643d77f219eec34f94f55889d
--- /dev/null
+++ b/thirdparty/libopus/silk/fixed/schur64_FIX.c
@@ -0,0 +1,93 @@
+/***********************************************************************
