index 0000000000000000000000000000000000000000..849b7c1c528ba6dc4bf2607edba419d760524097
--- /dev/null
+++ b/thirdparty/libopus/silk/float/LTP_analysis_filter_FLP.c
@@ -0,0 +1,75 @@
