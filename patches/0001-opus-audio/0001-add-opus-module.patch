index 0000000000000000000000000000000000000000..4a61406dbba60021c09b745d0737a5828e129823
--- /dev/null
+++ b/thirdparty/libopus/opus/opus_defines.h
@@ -0,0 +1,867 @@
+/* Copyright (c) 2010-2011 Xiph.Org Foundation, Skype Limited
+   Written by Jean-Marc Valin and Koen Vos */
