index 0000000000000000000000000000000000000000..05aba317889bd3a5766cb01bd18f9a4150a57d5c
--- /dev/null
+++ b/thirdparty/libopus/silk/fixed/process_gains_FIX.c
@@ -0,0 +1,117 @@
+/***********************************************************************
