index 0000000000000000000000000000000000000000..6c7cade9a078dc69307e75a6de3c849af12ba361
--- /dev/null
+++ b/thirdparty/libopus/silk/fixed/residual_energy_FIX.c
@@ -0,0 +1,98 @@
