index 0000000000000000000000000000000000000000..fe3b0bd31063c6f594e685fe958133ba709acc6e
--- /dev/null
+++ b/thirdparty/libopus/celt/pitch.c
@@ -0,0 +1,560 @@
+/* Copyright (c) 2007-2008 CSIRO
+   Copyright (c) 2007-2009 Xiph.Org Foundation
+   Written by Jean-Marc Valin */
+/**
+   @file pitch.c
+   @brief Pitch analysis
+ */
+
+/*
