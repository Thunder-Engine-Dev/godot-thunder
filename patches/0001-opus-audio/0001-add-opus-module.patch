index 0000000000000000000000000000000000000000..973c49770d151ba4e577a6eeef9242ea9b24be9d
--- /dev/null
+++ b/thirdparty/libopus/silk/dec_API.c
@@ -0,0 +1,509 @@
+/***********************************************************************
