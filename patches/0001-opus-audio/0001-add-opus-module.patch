+/* Add noise to matrix diagonal */
+void silk_regularize_correlations_FLP(
+    silk_float                      *XX,                                /* I/O  Correlation matrices                        */
+    silk_float                      *xx,                                /* I/O  Correlation values                          */
+    const silk_float                noise,                              /* I    Noise energy to add                         */
+    const opus_int                  D                                   /* I    Dimension of XX                             */
+)
+{
+    opus_int i;
+
+    for( i = 0; i < D; i++ ) {
+        matrix_ptr( &XX[ 0 ], i, i, D ) += noise;
+    }
+    xx[ 0 ] += noise;
+}
diff --git a/thirdparty/libopus/silk/float/residual_energy_FLP.c b/thirdparty/libopus/silk/float/residual_energy_FLP.c
new file mode 100644
index 0000000000000000000000000000000000000000..1bd07b33a4d4b687ef2e1860c89d6b09ee03234d
--- /dev/null
+++ b/thirdparty/libopus/silk/float/residual_energy_FLP.c
@@ -0,0 +1,117 @@
