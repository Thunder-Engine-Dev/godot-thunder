+    output[output_rows * i] = SHL32(tmp, RES_SHIFT-7);
+#else
+    output[output_rows * i] = SATURATE16((tmp + 64) >> 7);
+#endif
+#else
+    output[output_rows * i] = (1/(32768.f*32768.f))*tmp;
+#endif
+  }
