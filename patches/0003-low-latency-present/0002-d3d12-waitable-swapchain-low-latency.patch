 			print_verbose(vformat("D3D12: Presenting swapchain failed with error 0x%08ux.", (uint64_t)res));
 			any_present_failed = true;
@@ -2675,6 +2678,11 @@ void RenderingDeviceDriverD3D12::_swap_chain_release(SwapChain *p_swap_chain) {
 		p_swap_chain->render_pass = RenderPassID();
 	}
 
+	if (p_swap_chain->latency_waitable != nullptr) {
+		CloseHandle((HANDLE)p_swap_chain->latency_waitable);
+		p_swap_chain->latency_waitable = nullptr;
+	}
+	p_swap_chain->present_pending = false;
 	p_swap_chain->d3d_swap_chain.Reset();
 }
 
@@ -2759,6 +2767,9 @@ Error RenderingDeviceDriverD3D12::swap_chain_resize(CommandQueueID p_cmd_queue,
 		case DisplayServerEnums::VSYNC_ENABLED: {
 			sync_interval = 1;
 			present_flags = 0;
+			if (get_low_latency_mode() > 0) {
