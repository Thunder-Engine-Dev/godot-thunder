 		} break;
 		case DisplayServerEnums::VSYNC_DISABLED: {
 			sync_interval = 0;
@@ -2769,6 +2780,9 @@ Error RenderingDeviceDriverD3D12::swap_chain_resize(CommandQueueID p_cmd_queue,
 		default:
 			sync_interval = 1;
 			present_flags = 0;
+			if (get_low_latency_mode() > 0) {
