 	}
 
@@ -2884,6 +2898,13 @@ Error RenderingDeviceDriverD3D12::swap_chain_resize(CommandQueueID p_cmd_queue,
 	}
 #endif
 
+	if ((creation_flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT) && swap_chain->latency_waitable == nullptr) {
+		// Allow only one frame to be queued, so waiting on the object tells when the previous frame was taken for display.
+		if (SUCCEEDED(swap_chain->d3d_swap_chain->SetMaximumFrameLatency(1))) {
+			swap_chain->latency_waitable = (void *)swap_chain->d3d_swap_chain->GetFrameLatencyWaitableObject();
+		}
+	}
+
 	res = swap_chain->d3d_swap_chain->GetDesc1(&swap_chain_desc);
 	ERR_FAIL_COND_V(!SUCCEEDED(res), ERR_CANT_CREATE);
 	ERR_FAIL_COND_V(swap_chain_desc.BufferCount == 0, ERR_CANT_CREATE);
@@ -2973,6 +2994,20 @@ bool RenderingDeviceDriverD3D12::swap_chain_get_hdr_output_supported(SwapChainID
 	return true;
 }
 
+bool RenderingDeviceDriverD3D12::swap_chain_wait_for_present(SwapChainID p_swap_chain, uint32_t p_frames_back, uint64_t p_timeout_ns) {
+	if (p_swap_chain.id == 0) {
+		return false;
+	}
+	SwapChain *swap_chain = (SwapChain *)(p_swap_chain.id);
+	if (swap_chain->latency_waitable == nullptr || !swap_chain->present_pending) {
+		return false;
+	}
+	// The waitable object behaves like a semaphore: it must be waited on once per Present, otherwise the count drifts.
+	swap_chain->present_pending = false;
+	const DWORD timeout_ms = DWORD(MAX(uint64_t(1), p_timeout_ns / 1000000ULL));
+	return WaitForSingleObjectEx((HANDLE)swap_chain->latency_waitable, timeout_ms, TRUE) == WAIT_OBJECT_0;
+}
+
 void RenderingDeviceDriverD3D12::swap_chain_free(SwapChainID p_swap_chain) {
 	SwapChain *swap_chain = (SwapChain *)(p_swap_chain.id);
 	_swap_chain_release(swap_chain);
