+bool RenderingDeviceDriverVulkan::swap_chain_wait_for_present(SwapChainID p_swap_chain, uint32_t p_frames_back, uint64_t p_timeout_ns) {
+	if (!present_wait_enabled || p_swap_chain.id == 0) {
+		return false;
+	}
+	SwapChain *swap_chain = (SwapChain *)(p_swap_chain.id);
+	if (swap_chain->vk_swapchain == VK_NULL_HANDLE || swap_chain->present_id <= p_frames_back) {
+		return false;
+	}
+	VkResult err = device_functions.WaitForPresentKHR(vk_device, swap_chain->vk_swapchain, swap_chain->present_id - p_frames_back, p_timeout_ns);
+	return err == VK_SUCCESS;
+}
