+void RenderingDevice::_pace_note_present() {
+	if (pacing.mode >= 2 && pacing.t_start != 0) {
+		pacing.cost_ring[pacing.cost_idx++ % FramePacing::COST_SAMPLES] = OS::get_singleton()->get_ticks_usec() - pacing.t_start;
+	}
+}
+
+void RenderingDevice::pace_frame_begin() {
+	OS *os = OS::get_singleton();
+	if (pacing.mode < 0) {
+		pacing.mode = RenderingDeviceDriver::get_low_latency_mode();
+		const String env_margin = os->get_environment("GODOT_LOW_LATENCY_MARGIN_US");
+		if (!env_margin.is_empty()) {
+			pacing.margin_us = env_margin.to_int();
+		}
+		pacing.stats = !os->get_environment("GODOT_LOW_LATENCY_STATS").is_empty();
+		pacing.margin_us = CLAMP(pacing.margin_us, int64_t(300), int64_t(15000));
+	}
+	if (pacing.mode == 0 || !is_main_instance || DisplayServer::get_singleton() == nullptr) {
+		return;
+	}
+	// Only meaningful when presentation is tied to the display refresh.
+	const DisplayServerEnums::VSyncMode vsync = DisplayServer::get_singleton()->window_get_vsync_mode(DisplayServerEnums::MAIN_WINDOW_ID);
+	if (vsync != DisplayServerEnums::VSYNC_ENABLED && vsync != DisplayServerEnums::VSYNC_ADAPTIVE) {
+		pacing.t_vblank = 0;
+		return;
+	}
+	if (pacing.backoff > 0) {
+		// The driver could not tell us when a frame was shown (unsupported, minimized, occluded...).
+		pacing.backoff--;
+		pacing.t_vblank = 0;
+		return;
+	}
+	HashMap<DisplayServerEnums::WindowID, RDD::SwapChainID>::Iterator it = screen_swap_chains.find(DisplayServerEnums::MAIN_WINDOW_ID);
+	if (!it) {
+		return;
+	}
+
+	const float refresh = DisplayServer::get_singleton()->screen_get_refresh_rate(DisplayServerEnums::SCREEN_OF_MAIN_WINDOW);
+	const double nominal = refresh > 10.0f ? 1000000.0 / refresh : 0.0;
+
+	// Block until the previous frame is on screen, so that input is sampled right after a refresh
+	// instead of before an unpredictable stall inside the next frame.
+	const uint64_t wait_timeout_ns = nominal > 0.0 ? uint64_t(nominal * 3000.0) : 50000000ULL;
+	const bool waited = driver->swap_chain_wait_for_present(it->value, 0, wait_timeout_ns);
+	const uint64_t t1 = os->get_ticks_usec();
+	if (!waited) {
+		pacing.backoff = 60;
+		pacing.t_vblank = 0;
+		pacing.t_start = t1;
+		return;
+	}
+
+	if (pacing.t_vblank != 0 && nominal > 0.0) {
+		const double dt = double(t1 - pacing.t_vblank);
+		pacing.total++;
+		if (dt > nominal * 1.5) {
+			// The last frame needed an extra refresh: start earlier from now on.
+			pacing.missed++;
+			pacing.dyn_margin_us = MIN(pacing.dyn_margin_us + 1000, int64_t(nominal) - 500);
+			pacing.ok_streak = 0;
+		} else if (++pacing.ok_streak >= 90) {
+			// Many frames in a row were on time: try starting a little later.
+			pacing.dyn_margin_us = MAX(pacing.dyn_margin_us - 250, int64_t(300));
+			pacing.ok_streak = 0;
+		}
+		if (dt > nominal * 0.8 && dt < nominal * 1.2) {
+			pacing.period_us = pacing.period_us == 0.0 ? dt : (pacing.period_us * 0.98 + dt * 0.02);
+		}
+	}
+	pacing.t_vblank = t1;
+
+	uint64_t slept = 0;
+	if (pacing.mode >= 2 && pacing.period_us > 0.0) {
+		uint64_t cost = 0;
+		for (uint32_t i = 0; i < FramePacing::COST_SAMPLES; i++) {
+			cost = MAX(cost, pacing.cost_ring[i]);
+		}
+		// Start the frame as late as possible while still finishing before the next refresh.
+		const int64_t target = int64_t(t1) + int64_t(pacing.period_us) - int64_t(cost) - pacing.dyn_margin_us;
+		const int64_t now = int64_t(os->get_ticks_usec());
+		if (cost > 0 && target > now && target - now < int64_t(pacing.period_us)) {
+			const int64_t coarse = target - now - 300;
+			if (coarse > 0) {
+				os->delay_usec(coarse);
+			}
+			while (int64_t(os->get_ticks_usec()) < target) {
+			}
+			slept = os->get_ticks_usec() - t1;
+		}
+	}
+	// The platform loop read input before this function ran. Read again now, so that the frame sees
+	// whatever arrived while waiting for the previous frame to be shown and while sleeping.
+	DisplayServer::get_singleton()->process_events();
+	pacing.t_start = os->get_ticks_usec();
+
+	if (pacing.stats && (++pacing.counter % 180) == 0) {
+		print_line(vformat("LowLatency: mode %d, margin %d us, missed %d/%d, period %.0f us, slept %d us", pacing.mode, (int64_t)pacing.dyn_margin_us, (int64_t)pacing.missed, (int64_t)pacing.total, pacing.period_us, (int64_t)slept));
+	}
+}
