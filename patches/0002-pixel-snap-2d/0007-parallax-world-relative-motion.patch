+	// The layer shifts relative to the game world by (1 - scroll_scale) of the camera movement, plus
+	// autoscroll. That can be tiny on a slow camera, so it must not be detected from the transform
+	// delta: switching between GPU and canvas snap steps the layer back when the camera stops.
+	// A layer with scroll_scale 1 does not move relative to the world, which the delta shows correctly.
+	const bool autoscrolls = repeat_size.x || repeat_size.y;
+	const bool scrolling_x = scroll_scale.x != 1 || (autoscrolls && autoscroll.x != 0);
+	const bool scrolling_y = scroll_scale.y != 1 || (autoscrolls && autoscroll.y != 0);
+	RenderingServer::get_singleton()->canvas_item_set_snap_2d_world_motion(get_canvas_item(),
+			scrolling_x ? RendererSnap2D::WORLD_MOTION_SCROLLING : RendererSnap2D::WORLD_MOTION_AUTO,
+			scrolling_y ? RendererSnap2D::WORLD_MOTION_SCROLLING : RendererSnap2D::WORLD_MOTION_AUTO);
+}
