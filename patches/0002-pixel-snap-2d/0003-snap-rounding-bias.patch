+// Origins exactly on a pixel boundary (x.5) would flip between two pixels from float noise;
+// bias the tie so they always round the same way.
+const float TRANSFORM_SNAP_ROUNDING_BIAS = 0.001;
+
 void main() {
 	varying_A = vec4(read_draw_data_world_x, read_draw_data_world_y);
 	varying_B = read_draw_data_color_texture_pixel_size;
@@ -271,10 +275,10 @@ void main() {
 		vec2 transform_origin = (canvas_transform * model_matrix * vec4(0.0, 0.0, 0.0, 1.0)).xy;
 		vec2 snapped_origin = transform_origin;
 		if ((read_draw_data_flags & INSTANCE_FLAGS_SCREEN_TRANSFORM_SNAP_X) != uint(0)) {
-			snapped_origin.x = floor(transform_origin.x + 0.5);
+			snapped_origin.x = floor(transform_origin.x + 0.5 + TRANSFORM_SNAP_ROUNDING_BIAS);
 		}
 		if ((read_draw_data_flags & INSTANCE_FLAGS_SCREEN_TRANSFORM_SNAP_Y) != uint(0)) {
-			snapped_origin.y = floor(transform_origin.y + 0.5);
+			snapped_origin.y = floor(transform_origin.y + 0.5 + TRANSFORM_SNAP_ROUNDING_BIAS);
 		}
 		vertex += snapped_origin - transform_origin;
 		// Precision issue on some hardware creates artifacts within texture.
